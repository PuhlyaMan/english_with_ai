{
  "name": "easyenglish",
  "private": true,
  "description": "EasyEnglish — learn English with AI (Next.js).",
  "scripts": {
    "dev": "next dev -p 5173",
    "build": "next build",
    "start": "next start -p 5173",
    "lint": "eslint .",
